# -----------------------------------------------------------------------------
# Copy to .env.local for development. In production set these in your host
# (e.g. Vercel → Project → Settings → Environment Variables).
# -----------------------------------------------------------------------------

# Canonical origin of the website, no trailing slash. Used for canonical URLs,
# hreflang, sitemap, Open Graph and links inside emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API. The publishable/anon key is safe to expose:
# Row Level Security limits it to public content and the booking/contact RPCs.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional, server only. Lets the site record whether notification emails were
# delivered (booking_requests.notification_status). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# SMTP — any provider (Postmark, Mailgun, Brevo, Amazon SES, Google Workspace…).
# Port 465 uses implicit TLS; 587 uses STARTTLS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to guests, e.g. "Tišina <rezervacije@tisina-zagreb.hr>"
SMTP_FROM=
# Where booking requests and enquiries are delivered (comma-separated allowed)
RESTAURANT_NOTIFICATION_EMAIL=

# Send guests an acknowledgement email after a booking request (true/false)
SEND_GUEST_ACKNOWLEDGEMENT=true
